<UserControl
    x:Class="MinecraftServerManager.Controls.ResourceSparkline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid
        x:Name="ChartRoot"
        MinWidth="48"
        MinHeight="44"
        SizeChanged="ChartRoot_SizeChanged">
        <Canvas x:Name="ChartCanvas" Margin="0,1,0,10">
            <Line
                x:Name="UpperGuide"
                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                StrokeDashArray="2,3"
                StrokeThickness="1" />
            <Line
                x:Name="LowerGuide"
                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                StrokeDashArray="2,3"
                StrokeThickness="1" />
            <Path
                x:Name="HistoryArea"
                Opacity="0.14"
                StrokeThickness="0" />
            <Path
                x:Name="HistoryLine"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeThickness="2" />
        </Canvas>
        <TextBlock
            Margin="0,0,0,-2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="8"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="60s" />
        <TextBlock
            Margin="0,0,0,-2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontSize="8"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="now" />
    </Grid>
</UserControl>
