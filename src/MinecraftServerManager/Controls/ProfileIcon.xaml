<UserControl
    x:Class="MinecraftServerManager.Controls.ProfileIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid>
        <Border
            x:Name="FallbackBorder"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="100">
            <FontIcon
                x:Name="FallbackIcon"
                FontSize="20"
                Foreground="White"
                Glyph="&#xE8D4;" />
        </Border>
        <Border
            x:Name="ImageBorder"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="8"
            Visibility="Collapsed">
            <Image
                x:Name="IconImage"
                Stretch="UniformToFill" />
        </Border>
    </Grid>
</UserControl>
