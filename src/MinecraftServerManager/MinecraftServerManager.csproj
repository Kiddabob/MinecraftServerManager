<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MinecraftServerManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>0.1.0</Version>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>MinecraftServerManager.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Profiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UpdateSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyGeneratedWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_GeneratedWinUiPublishFile Include="$(TargetDir)App.xbf">
        <TargetPath>App.xbf</TargetPath>
      </_GeneratedWinUiPublishFile>
      <_GeneratedWinUiPublishFile Include="$(TargetDir)$(AssemblyName).pri">
        <TargetPath>$(AssemblyName).pri</TargetPath>
      </_GeneratedWinUiPublishFile>
      <_GeneratedWinUiView Include="$(TargetDir)Views\**\*.xbf" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_GeneratedWinUiPublishFile)"
      DestinationFiles="@(_GeneratedWinUiPublishFile-&gt;'$(PublishDir)%(TargetPath)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_GeneratedWinUiView)"
      DestinationFiles="@(_GeneratedWinUiView-&gt;'$(PublishDir)Views\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
