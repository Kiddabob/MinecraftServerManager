<Application
    x:Class="MinecraftServerManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infrastructure="using:MinecraftServerManager.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#25FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#22000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E660CDFF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC60CDFF" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#6660CDFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E660CDFF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CC60CDFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#60CDFF" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorForeground" Color="#60CDFF" />
            <SolidColorBrush x:Key="CheckBoxBackgroundChecked" Color="#60CDFF" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPointerOver" Color="#E660CDFF" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPressed" Color="#CC60CDFF" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedDisabled" Color="#6660CDFF" />
            <infrastructure:ServerStateToBrushConverter x:Key="ServerStateToBrushConverter" />
            <infrastructure:ServerLogLevelToBrushConverter x:Key="ServerLogLevelToBrushConverter" />
            <infrastructure:PlayerOnlineToBrushConverter x:Key="PlayerOnlineToBrushConverter" />

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BodySecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style
                x:Key="AppAccentButtonStyle"
                BasedOn="{StaticResource AccentButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="BulkSelectionToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid
                                x:Name="Root"
                                Width="32"
                                Height="32"
                                Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                                <Setter Target="SelectorFrame.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                                <Setter Target="SelectorFrame.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="SelectorFrame.Background" Value="#1460CDFF" />
                                                <Setter Target="SelectorFrame.BorderBrush" Value="#60CDFF" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused" />
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusBorder.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="SelectorFrame"
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Opacity="0.86">
                                    <FontIcon
                                        x:Name="CheckGlyph"
                                        FontSize="13"
                                        Foreground="#60CDFF"
                                        Glyph="&#xE73E;"
                                        Opacity="0" />
                                </Border>
                                <Border
                                    x:Name="FocusBorder"
                                    Width="32"
                                    Height="32"
                                    BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
