                                                    Spacing="5"
                                                    Visibility="{Binding Builder.ShowClientRuntimeVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Exact client loader" />
                                                    <ComboBox
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="DisplayName"
                                                        IsEnabled="{Binding Builder.IsNotResolvingPlatformVersions, Mode=OneWay}"
