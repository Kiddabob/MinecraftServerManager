<Window
    x:Class="MinecraftServerManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Loaded="RootGrid_Loaded"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Minecraft Server Manager"
            Subtitle="Servers, packs, players and worlds">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="MainNavigationView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            PaneClosed="MainNavigationView_PaneClosed"
            PaneDisplayMode="Auto"
            PaneOpened="MainNavigationView_PaneOpened"
            SelectionChanged="MainNavigationView_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel
                    x:Name="PaneHeaderContent"
                    Margin="0,10,0,12"
                    Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image
                            Width="32"
                            Height="32"
                            Source="/Assets/AppIcon.png" />
                        <StackPanel
                            x:Name="BrandTextStack"
                            VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Minecraft" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Server Manager" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="ProfilePaneContext"
                        Margin="0,2,8,0"
                        Padding="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{StaticResource SectionLabelStyle}"
                                Text="CURRENT SERVER" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Current server profile"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Profiles, Mode=OneWay}"
                                SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="OverviewNavigationItem"
                    Content="Overview"
                    IsSelected="True"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="SERVER" />
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Console" Tag="console">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Players" Tag="players">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Map" Tag="map">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE707;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Server files" Tag="files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mods &amp; plugins" Tag="content">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="PACKS" />
                <NavigationViewItem Content="Modpacks" Tag="modpacks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Build a pack" Tag="builder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Border
                    Margin="0,0,12,12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                    <ScrollViewer
                        x:Name="OverviewPage"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            MaxWidth="1080"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Overview" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Start, monitor, and safely stop the current Minecraft server." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:ProfileIcon
                                        Width="56"
                                        Height="56"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Selected server icon"
                                        FallbackGlyph="&#xE768;"
                                        IconPath="{Binding SelectedProfile.ProfileIconPath, Mode=OneWay}"
                                        StateBrush="{Binding SelectedProfile.State, Converter={StaticResource ServerStateToBrushConverter}}" />

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding SelectedProfile.StateText, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding SelectedProfile.StatusMessage, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SelectedProfile.ProcessInfo, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Command="{Binding SelectedProfile.StartCommand}"
                                            Content="Start server"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                        <Button Command="{Binding SelectedProfile.StopCommand}" Content="Stop safely" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource SectionTitleTextStyle}"
                                                Text="{Binding SelectedProfile.Readiness.Heading, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding SelectedProfile.Readiness.Summary, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                AutomationProperties.Name="Review and accept the Minecraft EULA"
                                                Click="AcceptEula_Click"
                                                Content="Review and accept EULA"
                                                Visibility="{Binding SelectedProfile.Readiness.NeedsEulaAcceptance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button
                                                Command="{Binding SelectedProfile.RefreshReadinessCommand}"
                                                Content="Refresh checks" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="16" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Launcher" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding SelectedProfile.Readiness.LauncherText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Java" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding SelectedProfile.Readiness.JavaText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Memory" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding SelectedProfile.Readiness.MemoryText, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Minecraft EULA" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="{Binding SelectedProfile.Readiness.EulaText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Selected server" />
                                        <Grid ColumnSpacing="16" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Profile" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedProfile.DisplayName, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding SelectedProfile.ProfileDetails, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Row="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Folder" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding SelectedProfile.ServerDirectory, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Java" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding SelectedProfile.JavaDetails, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Validation" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Text="{Binding SelectedProfile.ValidationText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="App updates" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding UpdateStatus, Mode=OneWay}" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            Command="{Binding ApplyUpdateCommand}"
                                            Content="Restart to update" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        x:Name="DashboardPage"
                        Margin="32,28,32,32"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Server dashboard" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Discover and safely edit configuration supplied by the selected server profile." />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding Dashboard.IsBusy, Mode=OneWay}" />
                                <Button Command="{Binding Dashboard.RefreshCommand}" Content="Rescan configuration" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Margin="0,18,0,14"
                            Style="{StaticResource AppCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="42"
                                        Height="42"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource AppAccentBrush}"
                                            Glyph="&#xE9D2;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding Dashboard.EnvironmentText, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Dashboard.SummaryText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{Binding Dashboard.ConfigurationSources, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MinWidth="180"
                                                    Padding="11,9"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource AppAccentBrush}"
                                                            Glyph="{Binding Glyph}" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding PresenceText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    x:Name="DashboardFileListColumn"
                                    Width="320"
                                    MinWidth="240"
                                    MaxWidth="520" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        Margin="12"
                                        PlaceholderText="Search configuration files"
                                        Text="{Binding Dashboard.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ListView
                                        Grid.Row="1"
                                        ItemsSource="{Binding Dashboard.ConfigurationFiles, Mode=OneWay}"
                                        SelectedItem="{Binding Dashboard.SelectedConfigurationFile, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="60" Padding="12,8" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Width="22"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource AppAccentBrush}"
                                                        Glyph="{Binding Glyph}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding RelativePath}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding SourceName}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Thumb
                                Grid.Column="1"
                                AutomationProperties.Name="Resize configuration file list"
                                DragDelta="DashboardSplitter_DragDelta">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border
                                                Width="2"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                CornerRadius="1" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="16,13" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Text="{Binding Dashboard.SelectedConfigurationFile.Name, Mode=OneWay, TargetNullValue=Configuration editor}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Dashboard.SelectedFileDetails, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Command="{Binding Dashboard.ReloadFileCommand}"
                                                Content="Reload"
                                                ToolTipService.ToolTip="Reload from disk and discard unsaved editor text" />
                                            <Button Command="{Binding Dashboard.DiscardCommand}" Content="Discard" />
                                            <Button
                                                Command="{Binding Dashboard.SaveCommand}"
                                                Content="Save safely"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        Padding="16,8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch
                                            AutomationProperties.Name="Configuration editor mode"
                                            IsEnabled="{Binding Dashboard.CanUseFriendlyEditor, Mode=OneWay}"
                                            IsOn="{Binding Dashboard.IsFriendlyMode, Mode=TwoWay}"
                                            OffContent="Text Editor"
                                            OnContent="User Friendly" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding Dashboard.FriendlyEditorSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Dashboard.FriendlyEditorGuidance, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="2"
                                        Visibility="{Binding Dashboard.IsFriendlyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListView
                                            Padding="12"
                                            IsEnabled="{Binding Dashboard.IsEditorEditable, Mode=OneWay}"
                                            ItemsSource="{Binding Dashboard.FriendlySettings, Mode=OneWay}"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="14,12"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="7">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                FontFamily="Cascadia Mono, Consolas"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Key}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Description}"
                                                                TextWrapping="Wrap" />
                                                            <ToggleSwitch
                                                                Margin="0,3,0,0"
                                                                IsOn="{Binding BooleanValue, Mode=TwoWay}"
                                                                OffContent="Off"
                                                                OnContent="On"
                                                                Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <NumberBox
                                                                Margin="0,3,0,0"
                                                                Maximum="{Binding Maximum}"
                                                                Minimum="{Binding Minimum}"
                                                                SmallChange="{Binding Step}"
                                                                SpinButtonPlacementMode="Compact"
                                                                Text="{Binding NumericText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ValidationMode="Disabled"
                                                                Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <ComboBox
                                                                Margin="0,3,0,0"
                                                                HorizontalAlignment="Stretch"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding Options}"
                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                Visibility="{Binding IsDropDown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <RadioButtons
                                                                Margin="0,3,0,0"
                                                                MaxColumns="3"
                                                                ItemsSource="{Binding Options}"
                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                Visibility="{Binding IsRadio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <RadioButtons.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding DisplayName}" />
                                                                    </DataTemplate>
                                                                </RadioButtons.ItemTemplate>
                                                            </RadioButtons>
                                                            <TextBox
                                                                Margin="0,3,0,0"
                                                                Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding LimitsText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                Text="{Binding ValidationText}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </Grid>

                                    <TextBox
                                        Grid.Row="2"
                                        MinWidth="360"
                                        Padding="14,12"
                                        AcceptsReturn="True"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="13"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        IsReadOnly="{Binding Dashboard.IsEditorReadOnly, Mode=OneWay}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollMode="Enabled"
                                        Text="{Binding Dashboard.DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="NoWrap"
                                        Visibility="{Binding Dashboard.IsFriendlyMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                                    <Grid Grid.Row="3" Padding="16,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource AppAccentBrush}"
                                            Glyph="&#xE946;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Dashboard.EditorNotice, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock
                            Grid.Row="3"
                            Margin="4,10,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Dashboard.StatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid
                        x:Name="ConsolePage"
                        Margin="32,28,32,32"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition
                                x:Name="ResourceSidebarColumn"
                                Width="300"
                                MinWidth="240"
                                MaxWidth="520" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Console" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Live Java output and server commands for the selected profile." />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedProfile.StatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{Binding SelectedProfile.StartCommand}"
                                    Content="Start"
                                    Style="{StaticResource AppAccentButtonStyle}" />
                                <Button Command="{Binding SelectedProfile.StopCommand}" Content="Stop safely" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            Padding="16"
                            Style="{StaticResource AppCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="Live resource usage" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SelectedProfile.ResourceUsageStatus, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10">
                                    <Border
                                        Padding="12,9"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource AppAccentBrush}"
                                                Glyph="&#xE9D9;" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="CPU" />
                                                <TextBlock
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SelectedProfile.CpuUsageText, Mode=OneWay}" />
                                                <controls:ResourceSparkline
                                                    Height="72"
                                                    Margin="0,4,0,0"
                                                    AutomationProperties.Name="CPU history for the last 60 seconds"
                                                    ItemsSource="{Binding SelectedProfile.CpuHistory, Mode=OneWay}"
                                                    LineBrush="#60CDFF"
                                                    Maximum="100" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border
                                        Padding="12,9"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource AppAccentBrush}"
                                                Glyph="&#xE950;" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Memory" />
                                                <TextBlock
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SelectedProfile.WorkingSetText, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding SelectedProfile.PrivateMemoryText, Mode=OneWay}" />
                                                <controls:ResourceSparkline
                                                    Height="72"
                                                    Margin="0,4,0,0"
                                                    AutomationProperties.Name="Memory history for the last 60 seconds"
                                                    ItemsSource="{Binding SelectedProfile.MemoryHistory, Mode=OneWay}"
                                                    LineBrush="#A78BFA"
                                                    MinimumRange="256" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="10,9"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel Spacing="3">
                                                    <FontIcon
                                                        HorizontalAlignment="Left"
                                                        Foreground="{StaticResource AppAccentBrush}"
                                                        Glyph="&#xE716;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Threads" />
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding SelectedProfile.ThreadCountText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,9"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel Spacing="3">
                                                    <FontIcon
                                                        HorizontalAlignment="Left"
                                                        Foreground="{StaticResource AppAccentBrush}"
                                                        Glyph="&#xE823;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Uptime" />
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding SelectedProfile.UptimeText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Thumb
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,20,0,0"
                            AutomationProperties.Name="Resize resource sidebar"
                            DragDelta="ResourcePaneSplitter_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <Border
                                            Width="2"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            CornerRadius="1" />
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <Border
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            Background="#111318"
                            CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="14,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="#E6EDF3"
                                        FontWeight="SemiBold"
                                        Text="Live log" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="#9DA7B3"
                                        Text="Newest messages appear automatically" />
                                </Grid>
                                <ListView
                                    x:Name="ConsoleLogList"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding SelectedProfile.ConsoleEntries, Mode=OneWay}"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                BorderBrush="#12FFFFFF"
                                                BorderThickness="0,0,0,1">
                                                <Grid MinWidth="880" MinHeight="38" Padding="10,6" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Background="{Binding Level, Converter={StaticResource ServerLogLevelToBrushConverter}}"
                                                        CornerRadius="2" />
                                                    <Grid
                                                        Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Top">
                                                        <Border
                                                            Background="{Binding Level, Converter={StaticResource ServerLogLevelToBrushConverter}}"
                                                            CornerRadius="12"
                                                            Opacity="0.18" />
                                                        <FontIcon
                                                            FontSize="12"
                                                            Foreground="{Binding Level, Converter={StaticResource ServerLogLevelToBrushConverter}}"
                                                            Glyph="{Binding Glyph}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11"
                                                        Foreground="#9DA7B3"
                                                        Text="{Binding TimeText}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding Level, Converter={StaticResource ServerLogLevelToBrushConverter}}"
                                                        Text="{Binding LevelText}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11"
                                                        Foreground="#B8C0CA"
                                                        Text="{Binding Source}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="12"
                                                        Foreground="#E6EDF3"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{Binding Message}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Margin="0,12,0,0"
                            Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="CommandTextBox"
                                    IsEnabled="{Binding SelectedProfile.CanSendCommands, Mode=OneWay}"
                                    KeyDown="CommandTextBox_KeyDown"
                                    PlaceholderText="Enter a server command, for example: list"
                                    Text="{Binding SelectedProfile.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SelectedProfile.SendCommand}"
                                    Content="Send"
                                    Style="{StaticResource AppAccentButtonStyle}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{Binding SelectedProfile.ListPlayersCommand}"
                                    Content="List players"
                                    ToolTipService.ToolTip="Run this profile's list-players command" />
                                <Button
                                    Click="BroadcastButton_Click"
                                    Content="Broadcast…"
                                    IsEnabled="{Binding SelectedProfile.CanBroadcast, Mode=OneWay}"
                                    ToolTipService.ToolTip="Prepare this profile's broadcast command" />
                                <Button
                                    Command="{Binding SelectedProfile.SaveNowCommand}"
                                    Content="Save now"
                                    ToolTipService.ToolTip="Ask the server to save immediately" />
                                <Button
                                    Command="{Binding SelectedProfile.StopCommand}"
                                    Content="Stop safely"
                                    ToolTipService.ToolTip="Save and stop using this profile's stop command" />
                                <Button
                                    Click="EmergencyStopButton_Click"
                                    Foreground="#FF6B6B"
                                    IsEnabled="{Binding SelectedProfile.CanEmergencyStop, Mode=OneWay}"
                                    Content="Emergency stop…"
                                    ToolTipService.ToolTip="Immediately terminate Java without waiting for a save" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="PlayersPage"
                        Margin="32,28,32,32"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Player playtime" />
                            <TextBlock
                                Style="{StaticResource BodySecondaryTextStyle}"
                                Text="Tracking starts with new joins on servers launched here; existing history is not backfilled." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,20,0,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Show" />
                            <ComboBox
                                Grid.Column="1"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding PlayerScopeOptions, Mode=OneWay}"
                                SelectedItem="{Binding SelectedPlayerScope, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding PlayerSummaryText, Mode=OneWay}" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="0">
                            <ListView
                                ItemsSource="{Binding PlayerPlaytimes, Mode=OneWay}"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.Header>
                                    <Grid
                                        MinWidth="840"
                                        Padding="16,12"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="Player" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Status" />
                                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Server breakdown" />
                                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Playtime" />
                                        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Last seen" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="840" MinHeight="54" Padding="16,10" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                                <controls:PlayerAvatar
                                                    Width="32"
                                                    Height="32"
                                                    AvatarPath="{Binding AvatarPath}"
                                                    PlayerName="{Binding PlayerName}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding PlayerName}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{Binding IsOnline, Converter={StaticResource PlayerOnlineToBrushConverter}}" />
                                                <TextBlock
                                                    Foreground="{Binding IsOnline, Converter={StaticResource PlayerOnlineToBrushConverter}}"
                                                    Text="{Binding StatusText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProfileSummary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontFamily="Cascadia Mono, Consolas"
                                                Text="{Binding PlaytimeText}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding LastSeenText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="MapPage"
                        Margin="32,28,32,32"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Server map" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="A read-only map built directly from saved world regions. No server plugin or web port is required." />
                            </StackPanel>
                            <ProgressRing
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                IsActive="{Binding Map.IsBusy, Mode=OneWay}"
                                Visibility="{Binding Map.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Margin="0,20,0,14"
                            Padding="16,12"
                            Style="{StaticResource AppCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Dimension" />
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="130"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding Map.Dimensions, Mode=OneWay}"
                                        SelectedItem="{Binding Map.SelectedDimension, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Area" />
                                    <ComboBox
                                        Grid.Column="3"
                                        MinWidth="130"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding Map.RadiusOptions, Mode=OneWay}"
                                        SelectedItem="{Binding Map.SelectedRadius, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Command="{Binding Map.RefreshCommand}"
                                        Content="Refresh now"
                                        Style="{StaticResource AppAccentButtonStyle}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Map.SelectedDimensionDetails, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Live refresh" />
                                        <ToggleSwitch
                                            VerticalAlignment="Center"
                                            IsOn="{Binding Map.IsLiveRefreshEnabled, Mode=TwoWay}" />
                                        <ComboBox
                                            Width="160"
                                            VerticalAlignment="Center"
                                            DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding Map.IsLiveRefreshEnabled, Mode=OneWay}"
                                            ItemsSource="{Binding Map.RefreshIntervalOptions, Mode=OneWay}"
                                            SelectedItem="{Binding Map.SelectedRefreshInterval, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="0" Style="{StaticResource AppCardStyle}">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="WorldMapScrollViewer"
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Enabled"
                                        MaxZoomFactor="4"
                                        MinZoomFactor="0.35"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled"
                                        ViewChanged="WorldMapScrollViewer_ViewChanged"
                                        ZoomMode="Enabled">
                                        <Grid
                                            Width="{Binding Map.MapWidth, Mode=OneWay}"
                                            Height="{Binding Map.MapHeight, Mode=OneWay}">
                                            <controls:WorldMapImage ImagePath="{Binding Map.ImagePath, Mode=OneWay}" />
                                            <Canvas>
                                                <Border
                                                    Width="20"
                                                    Height="20"
                                                    Canvas.Left="{Binding Map.SpawnLeft, Mode=OneWay}"
                                                    Canvas.Top="{Binding Map.SpawnTop, Mode=OneWay}"
                                                    Background="#D90078D4"
                                                    CornerRadius="10"
                                                    ToolTipService.ToolTip="{Binding Map.SpawnToolTip, Mode=OneWay}"
                                                    Visibility="{Binding Map.HasSpawnMarker, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform
                                                            CenterX="10"
                                                            CenterY="10"
                                                            ScaleX="{Binding Map.MarkerScale, Mode=OneWay}"
                                                            ScaleY="{Binding Map.MarkerScale, Mode=OneWay}" />
                                                    </Border.RenderTransform>
                                                    <FontIcon FontSize="11" Foreground="White" Glyph="&#xE80F;" />
                                                </Border>
                                                <ItemsControl
                                                    Width="{Binding Map.MapWidth, Mode=OneWay}"
                                                    Height="{Binding Map.MapHeight, Mode=OneWay}"
                                                    ItemsSource="{Binding Map.PlayerMarkers, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid
                                                                Width="32"
                                                                Height="32"
                                                                Opacity="{Binding Opacity}"
                                                                ToolTipService.ToolTip="{Binding ToolTipText}"
                                                                Visibility="{Binding IsVisibleOnMap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Grid.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform
                                                                            CenterX="16"
                                                                            CenterY="16"
                                                                            ScaleX="{Binding MarkerScale}"
                                                                            ScaleY="{Binding MarkerScale}" />
                                                                        <TranslateTransform
                                                                            X="{Binding CanvasLeft}"
                                                                            Y="{Binding CanvasTop}" />
                                                                    </TransformGroup>
                                                                </Grid.RenderTransform>
                                                                <Border
                                                                    Background="#D9202020"
                                                                    BorderBrush="White"
                                                                    BorderThickness="2"
                                                                    CornerRadius="8">
                                                                    <controls:PlayerAvatar
                                                                        Margin="2"
                                                                        AvatarPath="{Binding AvatarPath}"
                                                                        PlayerName="{Binding PlayerName}" />
                                                                </Border>
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    Margin="0,0,-2,-2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Fill="{Binding IsOnline, Converter={StaticResource PlayerOnlineToBrushConverter}}"
                                                                    Stroke="White"
                                                                    StrokeThickness="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl
                                                    Width="{Binding Map.MapWidth, Mode=OneWay}"
                                                    Height="{Binding Map.MapHeight, Mode=OneWay}"
                                                    ItemsSource="{Binding Map.PointsOfInterest, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid
                                                                Width="28"
                                                                Height="28"
                                                                ToolTipService.ToolTip="{Binding ToolTipText}"
                                                                Visibility="{Binding IsVisibleOnMap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Grid.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform
                                                                            CenterX="14"
                                                                            CenterY="14"
                                                                            ScaleX="{Binding MarkerScale}"
                                                                            ScaleY="{Binding MarkerScale}" />
                                                                        <TranslateTransform
                                                                            X="{Binding CanvasLeft}"
                                                                            Y="{Binding CanvasTop}" />
                                                                    </TransformGroup>
                                                                </Grid.RenderTransform>
                                                                <Border
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    BorderBrush="White"
                                                                    BorderThickness="2"
                                                                    CornerRadius="14">
                                                                    <FontIcon
                                                                        FontSize="13"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                        Glyph="&#xE707;" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>

                                    <Border
                                        Margin="12"
                                        Padding="10,7"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="#D9202020"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Foreground="White" Text="{Binding Map.CenterText, Mode=OneWay}" />
                                            <TextBlock Foreground="#CFFFFFFF" Text="Ctrl+wheel zoom • scroll to pan" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Padding="16" Style="{StaticResource AppCardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Players" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Positions are read from player files and can lag behind movement."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border
                                        Grid.Row="1"
                                        Padding="12,9"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Grid MinWidth="216" ColumnSpacing="12" RowSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Saved player positions" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                Width="44"
                                                MinWidth="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Include offline saved positions"
                                                IsOn="{Binding Map.ShowOfflinePlayers, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Include players who are currently offline."
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <ListView
                                        Grid.Row="2"
                                        ItemsSource="{Binding Map.PlayerMarkers, Mode=OneWay}"
                                        SelectedItem="{Binding Map.SelectedPlayerMarker, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="54" Padding="4" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:PlayerAvatar
                                                        Width="36"
                                                        Height="36"
                                                        VerticalAlignment="Center"
                                                        AvatarPath="{Binding AvatarPath}"
                                                        PlayerName="{Binding PlayerName}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding PlayerName}" />
                                                        <TextBlock
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding CoordinatesText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding DimensionDisplayName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding FreshnessText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button
                                        Grid.Row="3"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding Map.CenterOnSelectedPlayerCommand}"
                                        Content="Centre on selected player" />
                                    <StackPanel Grid.Row="4" Spacing="8">
                                        <Border
                                            Padding="12,9"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="Follow selected player" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Map.FocusSummary, Mode=OneWay}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    IsOn="{Binding Map.FollowSelectedPlayer, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent="" />
                                            </Grid>
                                        </Border>
                                        <Expander Header="Points of interest">
                                            <StackPanel Padding="0,8,0,2" Spacing="8">
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="Name"
                                                    ItemsSource="{Binding Map.PointsOfInterest, Mode=OneWay}"
                                                    PlaceholderText="Choose a saved place"
                                                    SelectedItem="{Binding Map.SelectedPointOfInterest, Mode=TwoWay}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Map.SelectedPointOfInterest.CoordinatesText, Mode=OneWay}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding Map.CenterOnSelectedPointCommand}"
                                                        Content="Centre" />
                                                    <Button
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding Map.RemoveSelectedPointCommand}"
                                                        Content="Remove" />
                                                </Grid>
                                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <TextBox
                                                    Header="New point"
                                                    MaxLength="80"
                                                    PlaceholderText="For example: Moon base"
                                                    Text="{Binding Map.NewPointName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox
                                                        Header="X"
                                                        Maximum="30000000"
                                                        Minimum="-30000000"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{Binding Map.NewPointX, Mode=TwoWay}" />
                                                    <NumberBox
                                                        Grid.Column="1"
                                                        Header="Y"
                                                        Maximum="4096"
                                                        Minimum="-2048"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{Binding Map.NewPointY, Mode=TwoWay}" />
                                                    <NumberBox
                                                        Grid.Column="2"
                                                        Header="Z"
                                                        Maximum="30000000"
                                                        Minimum="-30000000"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{Binding Map.NewPointZ, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding Map.UseMapCenterForPointCommand}"
                                                        Content="Use centre" />
                                                    <Button
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding Map.AddPointOfInterestCommand}"
                                                        Content="Save point"
                                                        Style="{StaticResource AppAccentButtonStyle}" />
                                                </Grid>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="3"
                                                    Text="{Binding Map.PointOfInterestStatus, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding Map.CenterOnSpawnCommand}"
                                            Content="Centre on world spawn" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{Binding Map.StatusText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{Binding Map.StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="FilesPage"
                        Margin="32,28,32,32"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Server files" />
                            <TextBlock
                                Style="{StaticResource BodySecondaryTextStyle}"
                                Text="Browse the selected profile's server folder without leaving the app." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,20,0,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Command="{Binding NavigateUpCommand}"
                                ToolTipService.ToolTip="Up one folder">
                                <FontIcon Glyph="&#xE74A;" />
                            </Button>
                            <Button
                                Grid.Column="1"
                                Command="{Binding RefreshFilesCommand}"
                                ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                            <Border
                                Grid.Column="2"
                                Padding="12,7"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    Text="{Binding CurrentFilesPath, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>

                        <ListView
                            x:Name="ServerFilesList"
                            Grid.Row="2"
                            IsItemClickEnabled="True"
                            ItemClick="ServerFilesList_ItemClick"
                            ItemsSource="{Binding ServerFiles, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.Header>
                                <Grid Height="36" Padding="12,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Name" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Type" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Size" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Modified" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" Padding="10,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource AppAccentBrush}"
                                                Glyph="{Binding Glyph}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Kind}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding ModifiedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Grid.Row="3"
                            Margin="4,10,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding FilesStatus, Mode=OneWay}" />
                    </Grid>

                    <ScrollViewer
                        x:Name="ContentPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="1120"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Mods &amp; plugins" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Review content installed for this profile and add server-compatible projects without editing the server folder by hand." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding Content.EnvironmentText, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Content.TargetSummary, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="#FF2CCB70"
                                            Text="{Binding Content.SafetyText, Mode=OneWay}"
                                            Visibility="{Binding Content.IsServerActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <TextBlock
                                            Foreground="#FFE84856"
                                            Text="{Binding Content.SafetyText, Mode=OneWay}"
                                            Visibility="{Binding Content.IsServerActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            IsActive="{Binding Content.IsBusy, Mode=OneWay}"
                                            Visibility="{Binding Content.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Command="{Binding Content.RefreshCommand}" Content="Rescan content" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" MinWidth="360" />
                                    <ColumnDefinition Width="2*" MinWidth="340" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource AppCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Installed content" />
                                        <ListView
                                            Grid.Row="1"
                                            Height="620"
                                            Margin="0,12,0,0"
                                            ItemsSource="{Binding Content.InstalledItems, Mode=OneWay}"
                                            SelectionMode="None">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="86" Padding="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="40"
                                                            Height="40"
                                                            VerticalAlignment="Top"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="8">
                                                            <FontIcon
                                                                Foreground="{StaticResource AppAccentBrush}"
                                                                Glyph="&#xE7FC;" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding VersionText}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding IdentityText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontFamily="Cascadia Mono"
                                                                FontSize="11"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding FileDetailsText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                                                            <TextBlock
                                                                Foreground="{StaticResource AppAccentBrush}"
                                                                Text="{Binding KindText}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding StateText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            Grid.Row="2"
                                            Margin="4,10,0,0"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Content.InventoryStatusText, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="16">
                                    <Border Style="{StaticResource AppCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Find compatible content" />
                                            <StackPanel Spacing="5">
                                                <TextBlock FontWeight="SemiBold" Text="Install into" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="KindText"
                                                    ItemsSource="{Binding Content.Targets, Mode=OneWay}"
                                                    PlaceholderText="No compatible content folder"
                                                    SelectedItem="{Binding Content.SelectedTarget, Mode=TwoWay}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="ServerContentSearchTextBox"
                                                    AutomationProperties.Name="Search compatible mods and plugins"
                                                    KeyDown="ServerContentSearchTextBox_KeyDown"
                                                    PlaceholderText="Search Modrinth"
                                                    Text="{Binding Content.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding Content.SearchCommand}"
                                                    Content="Search"
                                                    Style="{StaticResource AppAccentButtonStyle}" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Content.SearchStatusText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <ListView
                                                Height="250"
                                                ItemsSource="{Binding Content.SearchResults, Mode=OneWay}"
                                                SelectedItem="{Binding Content.SelectedProject, Mode=TwoWay}"
                                                SelectionMode="Single">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid MinHeight="76" Padding="6" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                Width="40"
                                                                Height="40"
                                                                VerticalAlignment="Top"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="7">
                                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                                    Text="{Binding MetadataText}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource AppAccentBrush}"
                                                                    Text="{Binding CompatibilityText}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Style="{StaticResource AppCardStyle}"
                                        Visibility="{Binding Content.HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <Image Source="{Binding Content.SelectedProject.IconUrl, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Content.SelectedProject.Title, Mode=OneWay, TargetNullValue=Choose a project}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Style="{StaticResource BodySecondaryTextStyle}"
                                                        Text="{Binding Content.SelectedProject.MetadataText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                MaxLines="3"
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Content.SelectedProject.Description, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Content.Versions, Mode=OneWay}"
                                                PlaceholderText="Choose a compatible version"
                                                SelectedItem="{Binding Content.SelectedVersion, Mode=TwoWay}" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Content.SelectedVersion.CompatibilityText, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Content.SelectedVersion.DependencyText, Mode=OneWay}" />
                                            <ItemsControl ItemsSource="{Binding Content.PlannedItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,2"
                                                            FontFamily="Cascadia Mono"
                                                            FontSize="11"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding DetailsText}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button
                                                Click="InstallServerContent_Click"
                                                Content="Review and install"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding Content.CanInstall, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <ProgressBar
                                                IsIndeterminate="{Binding Content.IsInstallProgressIndeterminate, Mode=OneWay}"
                                                Maximum="100"
                                                Minimum="0"
                                                Value="{Binding Content.InstallProgressValue, Mode=OneWay}"
                                                Visibility="{Binding Content.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Content.InstallStatusText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ModpacksPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="1120"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Find a modpack" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Search Modrinth, CurseForge, Technic, and Feed The Beast together, then narrow the catalogue by source, Minecraft version, loader, and pack style." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ModpackSearchTextBox"
                                            AutomationProperties.Name="Search all modpack providers"
                                            KeyDown="ModpackSearchTextBox_KeyDown"
                                            PlaceholderText="Search all providers, for example: Tekkit, Create, FTB Academy"
                                            Text="{Binding Modpacks.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Modpacks.SearchCommand}"
                                            Content="Search"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                    </Grid>

                                    <StackPanel Spacing="7">
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SOURCES" />
                                        <ItemsControl ItemsSource="{Binding Modpacks.ProviderFilters, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton
                                                        Content="{Binding DisplayName}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Style="{StaticResource FilterToggleButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock FontWeight="SemiBold" Text="Minecraft version" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Modpacks.MinecraftVersionOptions, Mode=OneWay}"
                                                SelectedItem="{Binding Modpacks.SelectedMinecraftVersion, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock FontWeight="SemiBold" Text="Mod loader" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Modpacks.LoaderOptions, Mode=OneWay}"
                                                SelectedItem="{Binding Modpacks.SelectedLoader, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="7">
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PACK STYLES" />
                                        <ItemsControl ItemsSource="{Binding Modpacks.CategoryFilters, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton
                                                        Content="{Binding DisplayName}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Style="{StaticResource FilterToggleButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding Modpacks.IsBusy, Mode=OneWay}"
                                            Visibility="{Binding Modpacks.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Modpacks.StatusText, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Up to 100 results per source" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" MinWidth="420" />
                                    <ColumnDefinition Width="2*" MinWidth="320" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Search results" />
                                        <ListView
                                            Height="510"
                                            ItemsSource="{Binding Modpacks.Results, Mode=OneWay}"
                                            SelectedItem="{Binding Modpacks.SelectedPack, Mode=TwoWay}"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="116" Padding="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="52"
                                                            Height="52"
                                                            VerticalAlignment="Top"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Image
                                                                Stretch="UniformToFill"
                                                                Source="{Binding IconUrl}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding MetadataText}" />
                                                            <TextBlock
                                                                MaxLines="2"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding Description}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{StaticResource AppAccentBrush}"
                                                                Text="{Binding VersionSummary}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding LoaderSummary}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Command="{Binding Modpacks.PreviousPageCommand}"
                                                Content="Previous" />
                                            <ListView
                                                x:Name="ModpackPageList"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                IsItemClickEnabled="True"
                                                ItemClick="ModpackPageList_ItemClick"
                                                ItemsSource="{Binding Modpacks.PageNumbers, Mode=OneWay}"
                                                SelectedItem="{Binding Modpacks.CurrentPage, Mode=OneWay}"
                                                SelectionMode="Single">
                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="MinWidth" Value="36" />
                                                        <Setter Property="MinHeight" Value="32" />
                                                        <Setter Property="Padding" Value="10,5" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                            </ListView>
                                            <Button
                                                Grid.Column="2"
                                                Command="{Binding Modpacks.NextPageCommand}"
                                                Content="Next" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Modpacks.PageSummary, Mode=OneWay}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Modpacks.PageSizeOptions, Mode=OneWay}"
                                                SelectedItem="{Binding Modpacks.SelectedPageSize, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="48"
                                                Height="48"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="8">
                                                <Image
                                                    Stretch="UniformToFill"
                                                    Source="{Binding Modpacks.SelectedPack.IconUrl, Mode=OneWay}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Modpacks.SelectedPack.Title, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.SelectedPack.MetadataText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Modpacks.SelectedPack.Description, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{StaticResource AppAccentBrush}"
                                            Text="{Binding Modpacks.SelectedPack.CategorySummary, Mode=OneWay}" />

                                        <StackPanel Spacing="5">
                                            <TextBlock FontWeight="SemiBold" Text="Published version" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Modpacks.Versions, Mode=OneWay}"
                                                PlaceholderText="Select a version"
                                                SelectedItem="{Binding Modpacks.SelectedVersion, Mode=TwoWay}" />
                                        </StackPanel>

                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Modpacks.SelectedVersion.MinecraftVersionsText, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.SelectedVersion.LoadersText, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.SelectedVersion.ServerCompatibilityText, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.JavaRecommendationText, Mode=OneWay}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono"
                                                    FontSize="12"
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.SelectedVersion.PackageText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Server-pack install" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.SelectedVersion.ImportReadinessText, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="The app uses each provider's official server route, verifies every published checksum, leaves EULA acceptance to you, and never overwrites an existing server folder." />
                                                <Border
                                                    Margin="0,6,0,0"
                                                    Padding="10"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock FontWeight="SemiBold" Text="App-managed instances" />
                                                        <TextBlock
                                                            FontFamily="Cascadia Mono"
                                                            FontSize="11"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding Modpacks.ManagedInstancesDirectory, Mode=OneWay}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="Stored outside the replaceable application files so app updates cannot remove a server."
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel
                                                    Margin="0,8,0,0"
                                                    Spacing="8">
                                                    <Button
                                                        Click="ImportModpackToManagedInstances_Click"
                                                        Content="{Binding Modpacks.ImportButtonText, Mode=OneWay}"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="{Binding Modpacks.CanImport, Mode=OneWay}"
                                                        Style="{StaticResource AppAccentButtonStyle}" />
                                                    <Button
                                                        Click="ImportModpackToCustomFolder_Click"
                                                        Content="Choose custom folder"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="{Binding Modpacks.CanImport, Mode=OneWay}" />
                                                </StackPanel>
                                                <ProgressBar
                                                    Margin="0,6,0,0"
                                                    IsIndeterminate="{Binding Modpacks.IsImportProgressIndeterminate, Mode=OneWay}"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    Value="{Binding Modpacks.ImportProgressValue, Mode=OneWay}"
                                                    Visibility="{Binding Modpacks.IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Modpacks.ImportStatusText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="BuilderPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="1120"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Build a pack" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Plan a client, a server, or a linked pair. The builder keeps side-only content out of the wrong instance and reviews dependencies before building the output."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Sources &amp; accounts" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Catalogue providers stay independent. One unavailable source never prevents another from being searched."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="36"
                                                Height="36"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource AppAccentBrush}"
                                                CornerRadius="8">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="17"
                                                    Foreground="White"
                                                    Glyph="&#xE8D7;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="7">
                                                <TextBlock FontWeight="SemiBold" Text="Modrinth" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="Public catalogue search is ready without an account."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="36"
                                                Height="36"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="17"
                                                    Glyph="&#xE192;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="CurseForge developer access" />
                                                    <TextBlock
                                                        Style="{StaticResource BodySecondaryTextStyle}"
                                                        Text="This connects an API key issued for your own approved developer application. It is not a CurseForge account login and does not expose a personal CurseForge library."
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Style="{StaticResource BodySecondaryTextStyle}"
                                                        Text="Prepare a personal application before opening Overwolf's official form. The app does not collect your contact details, accept the terms, or submit anything on your behalf."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressRing
                                                        Width="16"
                                                        Height="16"
                                                        IsActive="{Binding Builder.IsCurseForgeConnectionBusy, Mode=OneWay}"
                                                        Visibility="{Binding Builder.IsCurseForgeConnectionBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Style="{StaticResource BodySecondaryTextStyle}"
                                                        Text="{Binding Builder.CurseForgeConnectionStatusText, Mode=OneWay}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <HyperlinkButton
                                                            Content="Review terms"
                                                            NavigateUri="https://support.curseforge.com/support/solutions/articles/9000207405-curse-forge-3rd-party-api-terms-and-conditions" />
                                                        <Button
                                                            Click="PrepareCurseForgeApplication_Click"
                                                            Content="Prepare application" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button
                                                            Click="AddCurseForgeApiKey_Click"
                                                            Content="Add approved key"
                                                            IsEnabled="{Binding Builder.IsCurseForgeConnectionNotBusy, Mode=OneWay}"
                                                            Style="{StaticResource AppAccentButtonStyle}" />
                                                        <Button
                                                            Click="RemoveCurseForgeApiKey_Click"
                                                            Content="Disconnect"
                                                            IsEnabled="{Binding Builder.IsCurseForgeConnectionNotBusy, Mode=OneWay}"
                                                            Visibility="{Binding Builder.IsCurseForgeApiKeyStored, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="1. Choose the foundation" />
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Output" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Builder.BuildTargets, Mode=OneWay}"
                                                SelectedItem="{Binding Builder.SelectedTarget, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Minecraft version" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding Builder.IsNotBusy, Mode=OneWay}"
                                                ItemsSource="{Binding Builder.MinecraftVersions, Mode=OneWay}"
                                                PlaceholderText="Loading releases…"
                                                SelectedItem="{Binding Builder.SelectedMinecraftVersion, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="What to find" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Builder.ContentKinds, Mode=OneWay}"
                                                SelectedItem="{Binding Builder.SelectedContentKind, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource BodySecondaryTextStyle}"
                                        Text="{Binding Builder.TargetGuidance, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding Builder.ShowClientPlatform, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Client loader" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding Builder.ClientPlatforms, Mode=OneWay}"
                                                    SelectedItem="{Binding Builder.SelectedClientPlatform, Mode=TwoWay}" />
