<Window
    x:Class="MinecraftServerManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="24"
        RowSpacing="16"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Minecraft Server Manager" />
                <TextBlock
                    Foreground="Gray"
                    Text="Initial Tekkit server console" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Spacing="2">
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding StateText, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="Gray"
                    Text="{Binding ProcessInfo, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="24" RowSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold" Text="Profile" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ProfileName, Mode=OneWay}" />
                    <TextBlock Foreground="Gray" Text="{Binding ProfileDetails, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Server folder" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding ServerDirectory, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Java" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding JavaDetails, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Validation" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding ValidationText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Status" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Updates" />
                <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding UpdateStatus, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding ApplyUpdateCommand}"
                        Content="Restart to update" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{Binding StartCommand}"
                Content="Start Tekkit" />
            <Button
                Command="{Binding StopCommand}"
                Content="Stop safely" />
        </StackPanel>

        <TextBox
            x:Name="ConsoleTextBox"
            Grid.Row="3"
            AcceptsReturn="True"
            Background="#111318"
            FontFamily="Consolas"
            FontSize="13"
            Foreground="#E6EDF3"
            IsReadOnly="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{Binding ConsoleText, Mode=OneWay}"
            TextChanged="ConsoleTextBox_TextChanged"
            TextWrapping="NoWrap" />

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="CommandTextBox"
                IsEnabled="{Binding CanSendCommands, Mode=OneWay}"
                KeyDown="CommandTextBox_KeyDown"
                PlaceholderText="Enter a server command, for example: list"
                Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Command="{Binding SendCommand}"
                Content="Send" />
        </Grid>
    </Grid>
</Window>
