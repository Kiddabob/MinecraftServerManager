                                                        ItemsSource="{Binding Builder.ClientRuntimeVersions, Mode=OneWay}"
                                                        PlaceholderText="Resolving official versions…"
                                                        SelectedItem="{Binding Builder.SelectedClientRuntimeVersion, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Builder.ClientPlatformGuidance, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Padding="14"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding Builder.ShowServerPlatform, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Server platform" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding Builder.ServerPlatforms, Mode=OneWay}"
                                                    SelectedItem="{Binding Builder.SelectedServerPlatform, Mode=TwoWay}" />
                                                <StackPanel
                                                    Spacing="5"
                                                    Visibility="{Binding Builder.ShowServerRuntimeVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Exact server loader" />
                                                    <ComboBox
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="DisplayName"
                                                        IsEnabled="{Binding Builder.IsNotResolvingPlatformVersions, Mode=OneWay}"
                                                        ItemsSource="{Binding Builder.ServerRuntimeVersions, Mode=OneWay}"
                                                        PlaceholderText="Resolving official versions…"
                                                        SelectedItem="{Binding Builder.SelectedServerRuntimeVersion, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Builder.ServerPlatformGuidance, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding Builder.IsResolvingPlatformVersions, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsResolvingPlatformVersions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.PlatformVersionStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. Search supported providers" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BuilderSearchTextBox"
                                            AutomationProperties.Name="Search all supported pack catalogues"
                                            KeyDown="BuilderSearchTextBox_KeyDown"
                                            PlaceholderText="Search mods or plugins"
                                            Text="{Binding Builder.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Builder.Categories, Mode=OneWay}"
                                            SelectedItem="{Binding Builder.SelectedCategory, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Builder.SearchCommand}"
                                            Content="Search all providers"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding Builder.IsBusy, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.StatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Builder.ProviderStatuses, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontSize="12"
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding StatusText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Compatible projects" />
                                        <ListView
                                            Height="500"
                                            ItemsSource="{Binding Builder.SearchResults, Mode=OneWay}"
                                            SelectedItem="{Binding Builder.SelectedProject, Mode=TwoWay}"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="96" Padding="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="48"
                                                            Height="48"
                                                            VerticalAlignment="Top"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Image Stretch="UniformToFill" Source="{Binding IconUrl}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding MetadataText}" />
                                                            <TextBlock
                                                                MaxLines="2"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding Description}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{StaticResource AppAccentBrush}"
                                                                Text="{Binding ProviderId}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Version and compatibility" />
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{Binding Builder.SelectedProject.Title, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.SelectedProject.Description, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Builder.Versions, Mode=OneWay}"
                                            PlaceholderText="Select a published version"
                                            SelectedItem="{Binding Builder.SelectedVersion, Mode=TwoWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.VersionStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Builder.SelectedVersionDetails, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Button
                                            Click="ReviewBuilderItem_Click"
                                            Content="Add to draft"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding Builder.CanReviewAdd, Mode=OneWay}"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Compatible required dependencies are added automatically. Optional dependencies remain notices."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="3. Pack draft" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Builder.DraftCountText, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Builder.ClearDraftCommand}"
                                            Content="Clear draft" />
                                    </Grid>
                                    <ListView
                                        MaxHeight="360"
                                        ItemsSource="{Binding Builder.DraftItems, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="66" Padding="8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding SourceText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding Reason}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{StaticResource AppAccentBrush}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding PlacementText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding DetailsText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding Builder.DraftStatusText, Mode=OneWay}"
                                        Severity="Informational"
                                        Title="Planning draft" />
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="4. Build the reviewed output" />
                                        <TextBox
                                            Header="Pack name"
                                            MaxLength="80"
                                            PlaceholderText="My Minecraft Pack"
                                            Text="{Binding Builder.PackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.ManagedOutputDirectoryText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="DownloadBuilderDraftToManaged_Click"
                                                Content="Build in managed Instances"
                                                IsEnabled="{Binding Builder.CanCreateOutput, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                Click="DownloadBuilderDraftToFolder_Click"
                                                Content="Build in another folder"
                                                IsEnabled="{Binding Builder.CanCreateOutput, Mode=OneWay}" />
                                            <Button
                                                Click="OpenBuilderOutputFolder_Click"
                                                Content="Open output folder"
                                                Visibility="{Binding Builder.HasLastOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <ProgressBar
                                            IsIndeterminate="{Binding Builder.IsOutputProgressIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{Binding Builder.OutputProgressPercent, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsOutputBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.OutputStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="{Binding Builder.OutputCapabilityMessage, Mode=OneWay}"
                                            Severity="Warning"
                                            Title="{Binding Builder.OutputCapabilityTitle, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ProfilesPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="900"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Server profiles" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Profiles keep server-specific detection and launch details separate from the app core." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Add a Minecraft server" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Choose the folder containing the server launch script or runnable JAR. The app will preserve detected launch settings in a reusable profile." />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProfileImportStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <Button
                                            Click="ChooseServerFolder_Click"
                                            Content="Choose server folder"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                        <Button
                                            Click="DuplicateServerProfile_Click"
                                            Content="Duplicate selected"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding CanDuplicateSelectedProfile, Mode=OneWay}"
                                            ToolTipService.ToolTip="Create an independent editable copy of the selected stopped server" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SectionTitleTextStyle}"
                                            Text="{Binding ProfileCountText, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Click a row to open it. The small check includes it in Start selected and Stop selected." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SelectedProfileCountText, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="•" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ActiveServerCountText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{Binding StartSelectedCommand}"
                                                Content="Start selected"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                Command="{Binding StopSelectedCommand}"
                                                Content="Stop selected" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="ProfilesList"
                                    ItemsSource="{Binding Profiles, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorForeground" Color="#60CDFF" />
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="76" Padding="8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Include profile in multi-server actions"
                                                    IsChecked="{Binding IsSelectedForBulk, Mode=TwoWay}"
                                                    Style="{StaticResource BulkSelectionToggleStyle}"
                                                    ToolTipService.ToolTip="Include in Start selected and Stop selected" />
                                                <controls:ProfileIcon
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    IconPath="{Binding ProfileIconPath, Mode=OneWay}"
                                                    StateBrush="{Binding State, Converter={StaticResource ServerStateToBrushConverter}}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding State, Converter={StaticResource ServerStateToBrushConverter}}"
                                                            Text="{Binding StateText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="•" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding ServerDirectory}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button
                                                        Command="{Binding StartCommand}"
                                                        Content="Start"
                                                        Style="{StaticResource AppAccentButtonStyle}" />
                                                    <Button Command="{Binding StopCommand}" Content="Stop" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Launch settings" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="The app inspects server JARs directly. Launch scripts are used only as a hint when several JARs are present; their Java path, memory, and extra arguments are ignored."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Profile name" />
                                                <TextBox
                                                    AutomationProperties.Name="Profile name"
                                                    Text="{Binding ProfileDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Detected launcher" />
                                                <ComboBox
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding ProfileLauncherOptions, Mode=OneWay}"
                                                    SelectedItem="{Binding SelectedProfileLauncher, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Java runtime" />
                                            <ComboBox
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding JavaRuntimeOptions, Mode=OneWay}"
                                                PlaceholderText="Choose a detected Java runtime"
                                                SelectedItem="{Binding SelectedJavaRuntime, Mode=TwoWay}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    AutomationProperties.Name="Java executable path"
                                                    Text="{Binding ProfileJavaExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="ChooseJavaExecutable_Click"
                                                    Content="Choose Java…" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProfileCompatibilityText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="InstallRecommendedJava_Click"
                                                Content="{Binding RecommendedJavaInstallText, Mode=OneWay}"
                                                Visibility="{Binding IsRecommendedJavaInstallVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Initial memory (MB)" />
                                                <NumberBox
                                                    Minimum="256"
                                                    Maximum="262144"
                                                    SmallChange="256"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding ProfileInitialMemoryMb, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Maximum memory (MB)" />
                                                <NumberBox
                                                    Minimum="256"
                                                    Maximum="262144"
                                                    SmallChange="256"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding ProfileMaximumMemoryMb, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Additional Java arguments" />
                                            <TextBox
                                                AutomationProperties.Name="Additional Java arguments"
                                                FontFamily="Consolas"
                                                Text="{Binding ProfileAdditionalJavaArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Server arguments" />
                                            <TextBox
                                                AutomationProperties.Name="Server arguments"
                                                FontFamily="Consolas"
                                                Text="{Binding ProfileServerArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProfileEditorStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{Binding ApplyRecommendedSettingsCommand}"
                                                Content="Use recommended settings" />
                                            <Button
                                                Command="{Binding RedetectProfileCommand}"
                                                Content="Re-detect" />
                                            <Button
                                                Command="{Binding SaveProfileCommand}"
                                                Content="Save profile"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="SettingsPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="800"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Personalise the app and choose how often installed builds check GitHub Releases." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="App theme" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Follow Windows or keep the app light or dark." />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding ThemeOptions, Mode=OneWay}"
                                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                                        SelectionChanged="AppearanceSelectionChanged" />
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="Accent colour" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Used for app actions, profile, and folder highlights. Server status keeps its own health colour." />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding AccentOptions, Mode=OneWay}"
                                        SelectedItem="{Binding SelectedAccentOption, Mode=TwoWay}"
                                        SelectionChanged="AppearanceSelectionChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Managed Java runtimes" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Optional Eclipse Temurin runtimes are downloaded only when you choose Install. They are kept outside the app update folder and can be shared by all server profiles." />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ManagedJavaRuntimeOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,8" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding SupportText}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        MinWidth="132"
                                                        VerticalAlignment="Center"
                                                        Click="InstallManagedJava_Click"
                                                        Content="{Binding ActionText}"
                                                        IsEnabled="{Binding CanInstall}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel
                                        Spacing="8"
                                        Visibility="{Binding IsJavaInstallInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding JavaInstallProgressText, Mode=OneWay}" />
                                        <ProgressBar
                                            AutomationProperties.Name="Java installation progress"
                                            IsIndeterminate="{Binding IsJavaInstallProgressIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{Binding JavaInstallProgressPercent, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource BodySecondaryTextStyle}"
                                        Text="Java 16 is offered only for Minecraft 1.17 compatibility. It is an archived, end-of-support runtime; Java 8, 17, and 21 are maintained long-term-support lines." />
                                    <TextBlock
                                        Style="{StaticResource BodySecondaryTextStyle}"
                                        Text="Java 7 and older are not installed automatically. A legacy modpack that genuinely requires one can use a manually selected Java executable in its profile." />

                                    <Border
                                        Height="1"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Detected Java installations" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding JavaRuntimeSummary, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding RefreshJavaRuntimesCommand}"
                                            Content="Scan again" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding JavaRuntimeOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,4"
                                                    Padding="12"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding DetailsText}" />
                                                        <TextBlock
                                                            FontFamily="Cascadia Mono"
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding ExecutablePath}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="Check for updates" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Installed builds check GitHub in the background. Five minutes is the shortest interval." />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding UpdateIntervalOptions, Mode=OneWay}"
                                        SelectedItem="{Binding SelectedUpdateIntervalOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SettingsStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SaveSettingsCommand}"
                                    Content="Save settings"
                                    Style="{StaticResource AppAccentButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
