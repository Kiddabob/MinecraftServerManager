                                                        SelectedItem="{Binding Builder.SelectedClientRuntimeVersion, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Builder.ClientPlatformGuidance, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Padding="14"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding Builder.ShowServerPlatform, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Server platform" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding Builder.ServerPlatforms, Mode=OneWay}"
                                                    SelectedItem="{Binding Builder.SelectedServerPlatform, Mode=TwoWay}" />
                                                <StackPanel
                                                    Spacing="5"
                                                    Visibility="{Binding Builder.ShowServerRuntimeVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Exact server loader" />
                                                    <ComboBox
                                                        HorizontalAlignment="Stretch"
                                                        DisplayMemberPath="DisplayName"
                                                        IsEnabled="{Binding Builder.IsNotResolvingPlatformVersions, Mode=OneWay}"
                                                        ItemsSource="{Binding Builder.ServerRuntimeVersions, Mode=OneWay}"
                                                        PlaceholderText="Resolving official versions…"
                                                        SelectedItem="{Binding Builder.SelectedServerRuntimeVersion, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding Builder.ServerPlatformGuidance, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding Builder.IsResolvingPlatformVersions, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsResolvingPlatformVersions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.PlatformVersionStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="2. Search supported providers" />
                                    <StackPanel Spacing="7">
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SOURCES" />
                                        <ItemsControl ItemsSource="{Binding Builder.ProviderFilters, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton
                                                        Content="{Binding DisplayName}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Style="{StaticResource FilterToggleButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BuilderSearchTextBox"
                                            AutomationProperties.Name="Search all supported pack catalogues"
                                            KeyDown="BuilderSearchTextBox_KeyDown"
                                            PlaceholderText="Search mods or plugins"
                                            Text="{Binding Builder.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Builder.SortOptions, Mode=OneWay}"
                                            SelectedItem="{Binding Builder.SelectedSort, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="2"
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Builder.PageSizeOptions, Mode=OneWay}"
                                            SelectedItem="{Binding Builder.SelectedPageSize, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="3"
                                            Command="{Binding Builder.SearchCommand}"
                                            Content="Search all providers"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                    </Grid>
                                    <StackPanel Spacing="7">
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CONTENT FILTERS" />
                                        <ItemsControl ItemsSource="{Binding Builder.CategoryFilters, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton
                                                        Content="{Binding DisplayName}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Style="{StaticResource FilterToggleButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Minecraft version, loader, content type, and client/server side are inherited from the foundation above. Multiple content filters are combined for a narrower match."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding Builder.IsBusy, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.StatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Builder.ProviderStatuses, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontSize="12"
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="{Binding StatusText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Style="{StaticResource SectionTitleTextStyle}"
                                                Text="{Binding Builder.SearchResultsTitle, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Builder.SimilarContentExplanation, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ListView
                                            Height="500"
                                            ItemsSource="{Binding Builder.SearchResults, Mode=OneWay}"
                                            SelectedItem="{Binding Builder.SelectedProject, Mode=TwoWay}"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="96" Padding="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="48"
                                                            Height="48"
                                                            VerticalAlignment="Top"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Image Stretch="UniformToFill" Source="{Binding IconUrl}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding MetadataText}" />
                                                            <TextBlock
                                                                MaxLines="2"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding Description}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{StaticResource AppAccentBrush}"
                                                                Text="{Binding ProviderId}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <Button
                                            Command="{Binding Builder.ShowMoreCommand}"
                                            Content="Show more results"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding Builder.CanShowMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Command="{Binding Builder.PreviousSearchPageCommand}"
                                                Content="Previous" />
                                            <ListView
                                                x:Name="BuilderSearchPageList"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                IsItemClickEnabled="True"
                                                ItemClick="BuilderSearchPageList_ItemClick"
                                                ItemsSource="{Binding Builder.SearchPageNumbers, Mode=OneWay}"
                                                SelectedItem="{Binding Builder.CurrentSearchPage, Mode=OneWay}"
                                                SelectionMode="Single">
                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="MinWidth" Value="36" />
                                                        <Setter Property="MinHeight" Value="32" />
                                                        <Setter Property="Padding" Value="10,5" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                            </ListView>
                                            <Button
                                                Grid.Column="2"
                                                Command="{Binding Builder.NextSearchPageCommand}"
                                                Content="Next" />
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.SearchPageSummary, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Version and compatibility" />
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{Binding Builder.SelectedProject.Title, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.SelectedProject.Description, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Command="{Binding Builder.FindSimilarCommand}"
                                            Content="{Binding Builder.SimilarContentButtonText, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Builder.Versions, Mode=OneWay}"
                                            PlaceholderText="Select a published version"
                                            SelectedItem="{Binding Builder.SelectedVersion, Mode=TwoWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.VersionStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Padding="12"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Builder.SelectedVersionDetails, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Button
                                            Click="ReviewBuilderItem_Click"
                                            Content="Add to draft"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding Builder.CanReviewAdd, Mode=OneWay}"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Required dependencies are shown before they are added. Optional dependencies remain unchecked until you choose them."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="3. Pack draft" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding Builder.DraftCountText, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Builder.ClearDraftCommand}"
                                            Content="Clear draft" />
                                    </Grid>
                                    <ListView
                                        MaxHeight="360"
                                        ItemsSource="{Binding Builder.DraftItems, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="66" Padding="8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding SourceText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding Reason}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{StaticResource AppAccentBrush}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding PlacementText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding DetailsText}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="RemoveBuilderDraftItem_Click"
                                                        CommandParameter="{Binding}"
                                                        Content="Remove"
                                                        IsEnabled="{Binding CanRemove}"
                                                        ToolTipService.ToolTip="Required dependencies are removed automatically when no selected item needs them" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding Builder.DraftStatusText, Mode=OneWay}"
                                        Severity="Informational"
                                        Title="Planning draft" />
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="4. Build the reviewed output" />
                                        <TextBox
                                            Header="Pack name"
                                            MaxLength="80"
                                            PlaceholderText="My Minecraft Pack"
                                            Text="{Binding Builder.PackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.ManagedOutputDirectoryText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="DownloadBuilderDraftToManaged_Click"
                                                Content="Build in managed Instances"
                                                IsEnabled="{Binding Builder.CanCreateOutput, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                Click="DownloadBuilderDraftToFolder_Click"
                                                Content="Build in another folder"
                                                IsEnabled="{Binding Builder.CanCreateOutput, Mode=OneWay}" />
                                            <Button
                                                Click="OpenBuilderOutputFolder_Click"
                                                Content="Open output folder"
                                                Visibility="{Binding Builder.HasLastOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{Binding Builder.HasLastClientOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button
                                                Click="RegisterBuilderClientWithLauncher_Click"
                                                Content="Add client to Minecraft Launcher"
                                                IsEnabled="{Binding Builder.CanRegisterLastClientOutput, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                Click="OpenMinecraftLauncher_Click"
                                                Content="Open Minecraft Launcher"
                                                Visibility="{Binding Builder.HasLauncherProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ProgressRing
                                                Width="18"
                                                Height="18"
                                                IsActive="{Binding Builder.IsLauncherBusy, Mode=OneWay}"
                                                Visibility="{Binding Builder.IsLauncherBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.LauncherStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Builder.HasLastClientOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ProgressBar
                                            IsIndeterminate="{Binding Builder.IsOutputProgressIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{Binding Builder.OutputProgressPercent, Mode=OneWay}"
                                            Visibility="{Binding Builder.IsOutputBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding Builder.OutputStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="{Binding Builder.OutputCapabilityMessage, Mode=OneWay}"
                                            Severity="Warning"
                                            Title="{Binding Builder.OutputCapabilityTitle, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ProfilesPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="900"
                            Margin="32,28,32,40"
                            HorizontalAlignment="Stretch"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Server profiles" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Profiles keep server-specific detection and launch details separate from the app core." />
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Add a Minecraft server" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Choose the folder containing the server launch script or runnable JAR. The app will preserve detected launch settings in a reusable profile." />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProfileImportStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <Button
                                            Click="ChooseServerFolder_Click"
                                            Content="Choose server folder"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AppAccentButtonStyle}" />
                                        <Button
                                            Click="DuplicateServerProfile_Click"
                                            Content="Duplicate selected"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding CanDuplicateSelectedProfile, Mode=OneWay}"
                                            ToolTipService.ToolTip="Create an independent editable copy of the selected stopped server" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SectionTitleTextStyle}"
                                            Text="{Binding ProfileCountText, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Click a row to open it. The small check includes it in Start selected and Stop selected." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SelectedProfileCountText, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="•" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ActiveServerCountText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{Binding StartSelectedCommand}"
                                                Content="Start selected"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                Command="{Binding StopSelectedCommand}"
                                                Content="Stop selected" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="ProfilesList"
                                    ItemsSource="{Binding Profiles, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorForeground" Color="#60CDFF" />
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="76" Padding="8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Include profile in multi-server actions"
                                                    IsChecked="{Binding IsSelectedForBulk, Mode=TwoWay}"
                                                    Style="{StaticResource BulkSelectionToggleStyle}"
                                                    ToolTipService.ToolTip="Include in Start selected and Stop selected" />
                                                <controls:ProfileIcon
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    IconPath="{Binding ProfileIconPath, Mode=OneWay}"
                                                    StateBrush="{Binding State, Converter={StaticResource ServerStateToBrushConverter}}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding State, Converter={StaticResource ServerStateToBrushConverter}}"
                                                            Text="{Binding StateText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="•" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding ServerDirectory}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button
                                                        Command="{Binding StartCommand}"
                                                        Content="Start"
                                                        Style="{StaticResource AppAccentButtonStyle}" />
                                                    <Button Command="{Binding StopCommand}" Content="Stop" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Launch settings" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="The app inspects server JARs directly. Launch scripts are used only as a hint when several JARs are present; their Java path, memory, and extra arguments are ignored."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Profile name" />
                                                <TextBox
                                                    AutomationProperties.Name="Profile name"
                                                    Text="{Binding ProfileDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Detected launcher" />
                                                <ComboBox
                                                    DisplayMemberPath="DisplayName"
                                                    ItemsSource="{Binding ProfileLauncherOptions, Mode=OneWay}"
                                                    SelectedItem="{Binding SelectedProfileLauncher, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Java runtime" />
                                            <ComboBox
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding JavaRuntimeOptions, Mode=OneWay}"
                                                PlaceholderText="Choose a detected Java runtime"
                                                SelectedItem="{Binding SelectedJavaRuntime, Mode=TwoWay}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    AutomationProperties.Name="Java executable path"
                                                    Text="{Binding ProfileJavaExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="ChooseJavaExecutable_Click"
                                                    Content="Choose Java…" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProfileCompatibilityText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="InstallRecommendedJava_Click"
                                                Content="{Binding RecommendedJavaInstallText, Mode=OneWay}"
                                                Visibility="{Binding IsRecommendedJavaInstallVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Initial memory (MB)" />
                                                <NumberBox
                                                    Minimum="256"
                                                    Maximum="262144"
                                                    SmallChange="256"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding ProfileInitialMemoryMb, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="Maximum memory (MB)" />
                                                <NumberBox
                                                    Minimum="256"
                                                    Maximum="262144"
                                                    SmallChange="256"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding ProfileMaximumMemoryMb, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Additional Java arguments" />
                                            <TextBox
                                                AutomationProperties.Name="Additional Java arguments"
                                                FontFamily="Consolas"
                                                Text="{Binding ProfileAdditionalJavaArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Server arguments" />
                                            <TextBox
                                                AutomationProperties.Name="Server arguments"
                                                FontFamily="Consolas"
                                                Text="{Binding ProfileServerArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProfileEditorStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{Binding ApplyRecommendedSettingsCommand}"
                                                Content="Use recommended settings" />
                                            <Button
                                                Command="{Binding RedetectProfileCommand}"
                                                Content="Re-detect" />
                                            <Button
                                                Command="{Binding SaveProfileCommand}"
                                                Content="Save profile"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="SettingsPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="980"
                            Margin="32,22,32,40"
                            HorizontalAlignment="Center"
                            Spacing="20">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                                <TextBlock
                                    Style="{StaticResource BodySecondaryTextStyle}"
                                    Text="Control updates, visual style, Java runtimes and Windows integration." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="APP UPDATES" />

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="Installed version" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Command="{Binding CheckForUpdatesCommand}"
                                                Content="Check now" />
                                            <Button
                                                Command="{Binding ApplyUpdateCommand}"
                                                Content="Restart to update"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Automatic checks" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="Installed builds check GitHub Releases in the background. Five minutes is the shortest interval." />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="Check interval"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding UpdateIntervalOptions, Mode=OneWay}"
                                            SelectedItem="{Binding SelectedUpdateIntervalOption, Mode=TwoWay}" />
                                    </Grid>

                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding UpdateStatus, Mode=OneWay}"
                                        Severity="{Binding UpdateState, Converter={StaticResource AppUpdateStateToInfoBarSeverityConverter}}"
                                        Title="{Binding UpdateStatusTitle, Mode=OneWay}" />

                                    <ProgressBar
                                        AutomationProperties.Name="App update progress"
                                        IsIndeterminate="{Binding IsUpdateProgressIndeterminate, Mode=OneWay}"
                                        Maximum="100"
                                        Value="{Binding UpdateProgressPercent, Mode=OneWay}"
                                        Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Expander Header="Recent changes and release history">
                                        <StackPanel Padding="0,8,0,4" Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="Recent highlights" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="• Read-only server maps for legacy and modern Anvil worlds&#x0a;• Multi-provider pack discovery and verified pack output&#x0a;• Managed Java runtimes and automatic server launch recommendations"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="OpenExternalUri_Click"
                                                Content="Open full release history"
                                                Tag="https://github.com/Kiddabob/MinecraftServerManager/releases" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="APPEARANCE" />

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Appearance" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="These choices affect this app only and are saved for the current Windows account." />
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Theme" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Grid.Column="0"
                                                Click="ThemeChoice_Click"
                                                Style="{StaticResource AppearanceChoiceButtonStyle}"
                                                Tag="System">
                                                <Border
                                                    x:Name="SystemThemeCard"
                                                    Padding="8"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="9">
                                                    <StackPanel Spacing="7">
                                                        <Border
                                                            Height="56"
                                                            Background="#FFF7F7F7"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Rectangle Fill="#FFF7F7F7" />
                                                                <Rectangle Grid.Column="1" Fill="#FF202020" />
                                                                <Border
                                                                    Grid.ColumnSpan="2"
                                                                    Width="72"
                                                                    Height="18"
                                                                    Background="#FFE8E8E8"
                                                                    CornerRadius="4" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="System" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>

                                            <Button
                                                Grid.Column="1"
                                                Click="ThemeChoice_Click"
                                                Style="{StaticResource AppearanceChoiceButtonStyle}"
                                                Tag="Light">
                                                <Border
                                                    x:Name="LightThemeCard"
                                                    Padding="8"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="9">
                                                    <StackPanel Spacing="7">
                                                        <Border
                                                            Height="56"
                                                            Background="#FFF7F7F7"
                                                            BorderBrush="#22000000"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <StackPanel
                                                                Margin="14"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                                <Border Height="5" Background="#66000000" CornerRadius="3" />
                                                                <Border Width="64" Height="5" HorizontalAlignment="Left" Background="#22000000" CornerRadius="3" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="Light" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>

                                            <Button
                                                Grid.Column="2"
                                                Click="ThemeChoice_Click"
                                                Style="{StaticResource AppearanceChoiceButtonStyle}"
                                                Tag="Dark">
                                                <Border
                                                    x:Name="DarkThemeCard"
                                                    Padding="8"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="9">
                                                    <StackPanel Spacing="7">
                                                        <Border
                                                            Height="56"
                                                            Background="#FF202020"
                                                            BorderBrush="#33FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <StackPanel
                                                                Margin="14"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                                <Border Height="5" Background="#66FFFFFF" CornerRadius="3" />
                                                                <Border Width="64" Height="5" HorizontalAlignment="Left" Background="#22FFFFFF" CornerRadius="3" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="Dark" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Accent colour" />
                                                <TextBlock
                                                    Style="{StaticResource BodySecondaryTextStyle}"
                                                    Text="Used for actions, selections and focus. Server health colours stay fixed." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                                <Ellipse
                                                    x:Name="SelectedAccentPreview"
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    Fill="{StaticResource AppAccentBrush}" />
                                                <TextBlock
                                                    x:Name="SelectedAccentName"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>

                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="System">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="SystemAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse x:Name="SystemAccentSwatch" Width="28" Height="28" Fill="{StaticResource AppAccentBrush}" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Windows" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Coral">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="CoralAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse Width="28" Height="28" Fill="#F78370" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Coral" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Blue">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="BlueAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse Width="28" Height="28" Fill="#60CDFF" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Blue" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Emerald">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="EmeraldAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse Width="28" Height="28" Fill="#2CCB70" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Emerald" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Amethyst">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="AmethystAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse Width="28" Height="28" Fill="#A78BFA" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Amethyst" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Amber">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="AmberAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse Width="28" Height="28" Fill="#F5B942" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Amber" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AccentChoice_Click" Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Custom">
                                                    <StackPanel Spacing="4">
                                                        <Border x:Name="CustomAccentCard" Padding="3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18">
                                                            <Ellipse x:Name="CustomAccentSwatch" Width="28" Height="28" Fill="#60CDFF" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Custom" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="CustomAccentHexTextBox"
                                                Header="Custom RGB hex colour"
                                                MaxLength="7"
                                                PlaceholderText="#60CDFF"
                                                Text="{Binding CustomAccentHex, Mode=TwoWay}" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="0,24,0,0"
                                                VerticalAlignment="Top"
                                                Click="ApplyCustomAccent_Click"
                                                Content="Use custom colour" />
                                            <TextBlock
                                                x:Name="CustomAccentValidationMessage"
                                                Grid.Column="2"
                                                Margin="4,28,0,0"
                                                VerticalAlignment="Top"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Text="Enter a six-digit RGB colour such as #60CDFF."
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Window material" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="Mica is calmer; acrylic is more translucent. Windows may use a solid fallback when transparency is disabled." />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="Backdrop"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding BackdropOptions, Mode=OneWay}"
                                            SelectedItem="{Binding SelectedBackdropOption, Mode=TwoWay}"
                                            SelectionChanged="AppearanceSelectionChanged" />
                                    </Grid>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Windows accessibility" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="Text size and contrast remain Windows-wide choices and take priority over app colours." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OpenExternalUri_Click"
                                                Content="Text size"
                                                Tag="ms-settings:easeofaccess-display" />
                                            <Button
                                                Click="OpenExternalUri_Click"
                                                Content="Contrast themes"
                                                Tag="ms-settings:easeofaccess-highcontrast" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="JAVA AND RUNTIMES" />

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Managed Java runtimes" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="Optional Eclipse Temurin runtimes are downloaded only when you choose Install. They are kept outside the app update folder and can be shared by all server profiles." />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ManagedJavaRuntimeOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,8" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            Style="{StaticResource BodySecondaryTextStyle}"
                                                            Text="{Binding SupportText}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        MinWidth="132"
                                                        VerticalAlignment="Center"
                                                        Click="InstallManagedJava_Click"
                                                        Content="{Binding ActionText}"
                                                        IsEnabled="{Binding CanInstall}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel
                                        Spacing="8"
                                        Visibility="{Binding IsJavaInstallInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="{Binding JavaInstallProgressText, Mode=OneWay}" />
                                        <ProgressBar
                                            AutomationProperties.Name="Java installation progress"
                                            IsIndeterminate="{Binding IsJavaInstallProgressIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{Binding JavaInstallProgressPercent, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource BodySecondaryTextStyle}"
                                        Text="Java 16 is offered only for Minecraft 1.17 compatibility. It is an archived, end-of-support runtime; Java 8, 17, and 21 are maintained long-term-support lines." />
                                    <TextBlock
                                        Style="{StaticResource BodySecondaryTextStyle}"
                                        Text="Java 7 and older are not installed automatically. A legacy modpack that genuinely requires one can use a manually selected Java executable in its profile." />

                                    <Border
                                        Height="1"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Detected Java installations" />
                                            <TextBlock
                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                Text="{Binding JavaRuntimeSummary, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding RefreshJavaRuntimesCommand}"
                                            Content="Scan again" />
                                    </Grid>
                                    <Expander Header="Show detected installations">
                                        <ItemsControl
                                            Padding="0,8,0,0"
                                            ItemsSource="{Binding JavaRuntimeOptions, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,4"
                                                        Padding="12"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding DetailsText}" />
                                                            <TextBlock
                                                                FontFamily="Cascadia Mono"
                                                                FontSize="12"
                                                                Style="{StaticResource BodySecondaryTextStyle}"
                                                                Text="{Binding ExecutablePath}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ABOUT" />

                            <Border Style="{StaticResource AppCardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Width="48"
                                        Height="48"
                                        VerticalAlignment="Top"
                                        Source="/Assets/AppIcon.png" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Style="{StaticResource SectionTitleTextStyle}"
                                            Text="Minecraft Server Manager" />
                                        <TextBlock
                                            Style="{StaticResource BodySecondaryTextStyle}"
                                            Text="A local Windows manager for Minecraft servers, modpacks, players and worlds." />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="OpenExternalUri_Click"
                                        Content="View on GitHub"
                                        Tag="https://github.com/Kiddabob/MinecraftServerManager" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SettingsStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SaveSettingsCommand}"
                                    Content="Save settings"
                                    Style="{StaticResource AppAccentButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
